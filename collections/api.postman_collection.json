{
  "info": {
    "name": "ЛР4 API 10 методов",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 Список с фильтром",
      "request": {
        "method": "GET",
        "header": [],
        "url": "http://localhost:8086/api/fuel_consumptions?consumption_min=7&consumption_max=12"
      }
    },
    {
      "name": "02 Лента",
      "request": {
        "method": "GET",
        "header": [],
        "url": "http://localhost:8086/api/fuel_consumptions/feed"
      }
    },
    {
      "name": "03 Черновик",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer PASTE_JWT_HERE"
          }
        ],
        "url": "http://localhost:8086/api/fuel_consumptions/draft"
      }
    },
    {
      "name": "04 Добавить автомобиль",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer PASTE_JWT_HERE"
          }
        ],
        "url": "http://localhost:8086/api/fuel_consumptions",
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "name",
              "value": "Автомобиль ЛР4",
              "type": "text"
            },
            {
              "key": "image",
              "src": "media/cars_sedan.jpg",
              "type": "file"
            },
            {
              "key": "video",
              "src": "media/cars_sedan.mp4",
              "type": "file"
            }
          ]
        }
      }
    },
    {
      "name": "05 Опубликовать",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer PASTE_JWT_HERE"
          }
        ],
        "url": "http://localhost:8086/api/fuel_consumptions/11/publication",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"description\": \"Автомобиль для дальних поездок\",\n  \"consumption_rate\": 8.4,\n  \"fuel_tank_volume\": 60\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "06 Удалить автомобиль",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer PASTE_JWT_HERE"
          }
        ],
        "url": "http://localhost:8086/api/fuel_consumptions/11"
      }
    },
    {
      "name": "07 Лайк",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer PASTE_JWT_HERE"
          }
        ],
        "url": "http://localhost:8086/api/fuel_consumptions/11/likes",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"liked\": 1\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "08 Регистрация",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "http://localhost:8086/api/users",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"login\": \"student_lab3\",\n  \"full_name\": \"Студент РИП\",\n  \"password\": \"Lab3Demo123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "09 Вход — заглушка",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "http://localhost:8086/api/users/login",
        "body": {
          "mode": "raw",
          "raw": "{\"login\": \"creator\", \"password\": \"Lab4Demo123\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "10 Выход — заглушка",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer PASTE_JWT_HERE"
          }
        ],
        "url": "http://localhost:8086/api/users/logout"
      }
    }
  ]
}