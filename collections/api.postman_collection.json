{
  "info": {
    "name": "ЛР3 API 10 методов",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8085/api"
    },
    {
      "key": "car_id",
      "value": "6"
    }
  ],
  "item": [
    {
      "name": "01 Список с фильтром",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/fuel_consumptions?consumption_min=7&consumption_max=12"
      }
    },
    {
      "name": "02 Лента",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/fuel_consumptions/feed"
      }
    },
    {
      "name": "03 Черновик",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/fuel_consumptions/draft"
      }
    },
    {
      "name": "04 Добавить автомобиль",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{base_url}}/fuel_consumptions",
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "name",
              "value": "Автомобиль ЛР3",
              "type": "text"
            },
            {
              "key": "image",
              "src": "media/cars_sedan.jpg",
              "type": "file"
            },
            {
              "key": "video",
              "src": "media/cars_sedan.mp4",
              "type": "file"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 201) pm.collectionVariables.set(\"car_id\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Опубликовать",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/fuel_consumptions/{{car_id}}/publication",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"description\": \"Автомобиль для дальних поездок\",\n  \"consumption_rate\": 8.4,\n  \"fuel_tank_volume\": 60\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "06 Удалить автомобиль",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{base_url}}/fuel_consumptions/{{car_id}}"
      }
    },
    {
      "name": "07 Лайк",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/fuel_consumptions/{{car_id}}/likes",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"liked\": 1\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "08 Регистрация",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/users",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"login\": \"student_lab3\",\n  \"full_name\": \"Студент РИП\",\n  \"password\": \"Lab3Demo123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "09 Вход — заглушка",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{base_url}}/users/login"
      }
    },
    {
      "name": "10 Выход — заглушка",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{base_url}}/users/logout"
      }
    }
  ]
}